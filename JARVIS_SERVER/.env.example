# Required: your OpenAI API key. Never commit the real key.
OPENAI_API_KEY=

# Optional: change the model without changing the app.
OPENAI_MODEL=gpt-5.6-luna

# Optional: protect the JARVIS endpoint with a shared key.
JARVIS_API_KEY=

# Optional: customize JARVIS personality.
JARVIS_SYSTEM_PROMPT=Eres JARVIS, un asistente de IA personal. Responde en español salvo que el usuario pida otro idioma. Sé claro, útil, natural y conciso. No inventes acciones que no hayas realizado.
