<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#05070B">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S • AJUSTES"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#19C8FF"
        android:layout_marginBottom="28dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Servidor de IA"
        android:textColor="#D8EAF2"
        android:textSize="16sp"/>

    <EditText
        android:id="@+id/aiEndpoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://tu-servidor/ask"
        android:inputType="textUri"
        android:textColor="#FFFFFF"
        android:textColorHint="#6F8792"
        android:layout_marginTop="10dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="JARVIS enviará {&quot;message&quot;:&quot;...&quot;} mediante HTTPS. No guardamos ninguna API key en la aplicación."
        android:textColor="#8BA7B5"
        android:textSize="13sp"
        android:layout_marginTop="14dp"/>

    <Button
        android:id="@+id/saveSettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="GUARDAR"
        android:textColor="#19C8FF"
        android:background="@drawable/hud_button"
        android:layout_marginTop="24dp"/>
</LinearLayout>
